diff --git a/tests/session_stats_test.sh b/tests/session_stats_test.sh
new file mode 100644
index 0000000..55da635
--- /dev/null
+++ b/tests/session_stats_test.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+repository_root="$(cd "$(dirname "$0")/.." && pwd)"
+test_directory="$(mktemp -d "$repository_root/tests/session-stats.XXXXXX")"
+trap 'rm -rf -- "$test_directory"' EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+# Validate the public Compose/psql boundary without connecting to a database.
+docker_probe="$test_directory/docker probe"
+cat > "$docker_probe" <<'PROBE'
+#!/usr/bin/env bash
+set -euo pipefail
+expected=(compose --file compose.yaml exec --no-TTY postgres psql
+  --no-psqlrc --csv --quiet --username analytics --dbname analytics
+  --set ON_ERROR_STOP=1 --command)
+[[ $# -eq $((${#expected[@]} + 1)) ]]
+for argument in "${expected[@]}"; do
+  [[ "$1" == "$argument" ]]
+  shift
+done
+[[ "$1" == "SELECT count(*) AS total, count(*) FILTER (WHERE status IN ('queued', 'collecting')) AS active, count(*) FILTER (WHERE status = 'complete') AS complete, count(*) FILTER (WHERE status = 'failed') AS failed FROM analytical_session WHERE deleted_at IS NULL;" ]]
+printf 'call\n' >> "$STATS_CALLS"
+if [[ "${STATS_FAIL:-0}" == 1 ]]; then
+  printf 'database unavailable\n' >&2
+  exit 1
+fi
+printf 'total,active,complete,failed\n%s\n' "$STATS_ROW"
+PROBE
+chmod +x "$docker_probe"
+export STATS_CALLS="$test_directory/calls"
+
+for row in '0,0,0,0' '8,3,2,1'; do
+  : > "$STATS_CALLS"
+  output="$(STATS_ROW="$row" make --no-print-directory --directory="$repository_root" session-stats DOCKER="$docker_probe")"
+  [[ "$output" == $'total,active,complete,failed\n'"$row" ]] || fail 'stdout must contain only CSV'
+  [[ "$(cat "$STATS_CALLS")" == call ]] || fail 'expected exactly one SQL invocation'
+done
+
+if STATS_FAIL=1 STATS_ROW=0,0,0,0 make --no-print-directory --directory="$repository_root" \
+  session-stats DOCKER="$docker_probe" > "$test_directory/stdout" 2> "$test_directory/stderr"; then
+  fail 'database errors must fail the command'
+fi
+[[ ! -s "$test_directory/stdout" ]] || fail 'database errors must not produce success CSV'
+
+help_output="$(make --no-print-directory --directory="$repository_root" help)"
+[[ "$help_output" == *session-stats* ]] || fail 'help must list session-stats'
+printf 'PASS: session-stats\n'
