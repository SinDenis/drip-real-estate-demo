diff --git a/tests/session_stats_test.sh b/tests/session_stats_test.sh
new file mode 100644
index 0000000..bc83e85
--- /dev/null
+++ b/tests/session_stats_test.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repository_root="$(cd "$(dirname "$0")/.." && pwd)"
+test_directory="$(mktemp -d "$repository_root/tests/session-stats.XXXXXX")"
+trap 'rm -rf -- "$test_directory"' EXIT
+
+# This double verifies the public command and SQL sent to psql, without a DB.
+docker_probe="$test_directory/docker probe"
+cat > "$docker_probe" <<'PROBE'
+#!/usr/bin/env bash
+set -euo pipefail
+expected=(compose --file compose.yaml exec --no-TTY postgres psql
+  --no-psqlrc --csv --quiet --username analytics --dbname analytics
+  --set ON_ERROR_STOP=1 --command)
+[[ $# -eq $((${#expected[@]} + 1)) ]]
+for argument in "${expected[@]}"; do
+  [[ "$1" == "$argument" ]]
+  shift
+done
+[[ "$1" == "SELECT count(*) AS total, count(*) FILTER (WHERE status IN ('queued', 'collecting')) AS active, count(*) FILTER (WHERE status = 'complete') AS complete, count(*) FILTER (WHERE status = 'failed') AS failed FROM analytical_session WHERE deleted_at IS NULL;" ]]
+printf 'call\n' >> "$SESSION_STATS_CALLS"
+if [[ "${SESSION_STATS_FAIL:-0}" == 1 ]]; then
+  exit 1
+fi
+printf 'total,active,complete,failed\n%s\n' "$SESSION_STATS_ROW"
+PROBE
+chmod +x "$docker_probe"
+export SESSION_STATS_CALLS="$test_directory/calls"
+
+for row in '0,0,0,0' '9,3,2,1'; do
+  export SESSION_STATS_ROW="$row"
+  : > "$SESSION_STATS_CALLS"
+  # A same-named file must not disable the phony target.
+  touch "$test_directory/session-stats"
+  output="$(cd "$test_directory" && make --no-print-directory \
+    --file="$repository_root/Makefile" session-stats DOCKER="$docker_probe")"
+  [[ "$output" == "$(printf 'total,active,complete,failed\n%s' "$row")" ]]
+  [[ "$(cat "$SESSION_STATS_CALLS")" == call ]]
+done
+
+export SESSION_STATS_FAIL=1
+if make --no-print-directory --directory="$repository_root" \
+  session-stats DOCKER="$docker_probe" > "$test_directory/output" 2>/dev/null; then
+  printf 'FAIL: database failure must propagate\n' >&2
+  exit 1
+fi
+[[ ! -s "$test_directory/output" ]]
+help_output="$(make --no-print-directory --directory="$repository_root" help)"
+[[ "$help_output" == *session-stats* ]]
+printf 'PASS: session-stats command contract (mock PostgreSQL)\n'
