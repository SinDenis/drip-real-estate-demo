diff --git a/backend/internal/adapters/httpapi/liveness_test.go b/backend/internal/adapters/httpapi/liveness_test.go
new file mode 100644
index 0000000..38b64c8
--- /dev/null
+++ b/backend/internal/adapters/httpapi/liveness_test.go
@@ -0,0 +1,69 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+type forbiddenLivenessProbe struct{ t *testing.T }
+
+func (probe forbiddenLivenessProbe) Check(context.Context) error {
+	probe.t.Fatal("liveness called an infrastructure probe")
+	return nil
+}
+
+func TestLivenessReturnsServiceWithoutProbingInfrastructure(t *testing.T) {
+	t.Parallel()
+	handler := httpapi.NewHandler(httpapi.Dependencies{
+		Readiness: application.NewReadinessService(forbiddenLivenessProbe{t: t}),
+	})
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health/live", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", response.Code)
+	}
+	if got := response.Header().Get("Content-Type"); got != "application/json" {
+		t.Fatalf("Content-Type = %q, want application/json", got)
+	}
+	var body map[string]any
+	if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{"status": "live", "service": "DRIP Недвижимость"}
+	if !reflect.DeepEqual(body, want) {
+		t.Fatalf("body = %v, want %v", body, want)
+	}
+}
+
+func TestReadinessResponseKeepsExistingFields(t *testing.T) {
+	t.Parallel()
+	for _, status := range []string{"ready", "not_ready"} {
+		t.Run(status, func(t *testing.T) {
+			probe := staticProbe{}
+			code := http.StatusOK
+			if status == "not_ready" {
+				probe.err = context.DeadlineExceeded
+				code = http.StatusServiceUnavailable
+			}
+			response := httptest.NewRecorder()
+			newHandler(probe).ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health/ready", nil))
+			if response.Code != code {
+				t.Fatalf("status = %d, want %d", response.Code, code)
+			}
+			var body map[string]any
+			if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(body, map[string]any{"status": status}) {
+				t.Fatalf("unexpected readiness body: %v", body)
+			}
+		})
+	}
+}
