index 0000000..ba266b2
--- /dev/null
+++ b/backend/internal/adapters/httpapi/liveness_service_test.go
@@ -0,0 +1,80 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+type countingHealthProbe struct {
+	calls int
+	err   error
+}
+
+func (probe *countingHealthProbe) Check(context.Context) error {
+	probe.calls++
+	return probe.err
+}
+
+func TestLivenessServiceResponse(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		name        string
+		path        string
+		unavailable bool
+		code        int
+		body        map[string]string
+		calls       int
+	}{
+		{"live healthy", "/health/live", false, http.StatusOK, map[string]string{"status": "live", "service": "DRIP Недвижимость"}, 0},
+		{"live unavailable", "/health/live", true, http.StatusOK, map[string]string{"status": "live", "service": "DRIP Недвижимость"}, 0},
+		{"ready healthy", "/health/ready", false, http.StatusOK, map[string]string{"status": "ready"}, 1},
+		{"ready unavailable", "/health/ready", true, http.StatusServiceUnavailable, map[string]string{"status": "not_ready"}, 1},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			handler, probe := healthHandler(test.unavailable)
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, test.path, nil))
+			if response.Code != test.code {
+				t.Fatalf("status = %d, want %d", response.Code, test.code)
+			}
+			assertHealthBody(t, response, test.body)
+			if probe.calls != test.calls {
+				t.Fatalf("probe calls = %d, want %d", probe.calls, test.calls)
+			}
+		})
+	}
+}
+
+func assertHealthBody(t *testing.T, response *httptest.ResponseRecorder, want map[string]string) {
+	t.Helper()
+	if got := response.Header().Get("Content-Type"); got != "application/json" {
+		t.Fatalf("Content-Type = %q", got)
+	}
+	var body map[string]string
+	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(body, want) {
+		t.Fatalf("body = %#v, want %#v", body, want)
+	}
+}
+
+func healthHandler(unavailable bool) (http.Handler, *countingHealthProbe) {
+	probe := &countingHealthProbe{}
+	if unavailable {
+		probe.err = errors.New("infrastructure unavailable")
+	}
+	return httpapi.NewHandler(httpapi.Dependencies{
+		Readiness: application.NewReadinessService(probe),
+	}), probe
+}
