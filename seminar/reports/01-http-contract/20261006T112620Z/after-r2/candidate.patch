diff --git a/backend/internal/adapters/httpapi/liveness_test.go b/backend/internal/adapters/httpapi/liveness_test.go
new file mode 100644
index 0000000..6eb0749
--- /dev/null
+++ b/backend/internal/adapters/httpapi/liveness_test.go
@@ -0,0 +1,67 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+type unexpectedLivenessProbe struct{ t *testing.T }
+
+func (probe unexpectedLivenessProbe) Check(context.Context) error {
+	probe.t.Fatal("liveness called an infrastructure probe")
+	return errors.New("infrastructure unavailable")
+}
+
+func TestLivenessResponseIncludesServiceWithoutProbingInfrastructure(t *testing.T) {
+	t.Parallel()
+	handler := httpapi.NewHandler(httpapi.Dependencies{
+		Readiness: application.NewReadinessService(unexpectedLivenessProbe{t: t}),
+	})
+	assertHealthBody(t, handler, "/health/live", http.StatusOK, map[string]string{
+		"status": "live", "service": "DRIP Недвижимость",
+	})
+}
+
+func TestReadinessResponseRemainsUnchanged(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		name   string
+		err    error
+		code   int
+		status string
+	}{
+		{name: "available", code: http.StatusOK, status: "ready"},
+		{name: "unavailable", err: errors.New("storage unavailable"), code: http.StatusServiceUnavailable, status: "not_ready"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			assertHealthBody(t, newHandler(staticProbe{err: test.err}), "/health/ready", test.code, map[string]string{"status": test.status})
+		})
+	}
+}
+
+func assertHealthBody(t *testing.T, handler http.Handler, path string, code int, expected map[string]string) {
+	t.Helper()
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, path, nil))
+	if response.Code != code {
+		t.Fatalf("HTTP status = %d, want %d", response.Code, code)
+	}
+	if contentType := response.Header().Get("Content-Type"); contentType != "application/json" {
+		t.Fatalf("Content-Type = %q, want application/json", contentType)
+	}
+	var body map[string]string
+	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+		t.Fatalf("decode response: %v", err)
+	}
+	if !reflect.DeepEqual(body, expected) {
+		t.Fatalf("body = %v, want %v", body, expected)
+	}
+}
