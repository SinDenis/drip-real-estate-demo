@@ -0,0 +1,66 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+type forbiddenLivenessProbe struct{}
+
+func (forbiddenLivenessProbe) Check(context.Context) error {
+	panic("liveness must not check infrastructure")
+}
+
+func TestLivenessServiceResponse(t *testing.T) {
+	t.Parallel()
+
+	handler := httpapi.NewHandler(httpapi.Dependencies{
+		Readiness: application.NewReadinessService(forbiddenLivenessProbe{}, forbiddenLivenessProbe{}),
+	})
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health/live", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", response.Code)
+	}
+	if got := response.Header().Get("Content-Type"); got != "application/json" {
+		t.Fatalf("Content-Type = %q, want application/json", got)
+	}
+	var body map[string]string
+	if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+		t.Fatalf("decode liveness: %v", err)
+	}
+	want := map[string]string{"status": "live", "service": "DRIP Недвижимость"}
+	if !reflect.DeepEqual(body, want) {
+		t.Fatalf("body = %v, want %v", body, want)
+	}
+}
+
+func TestReadinessResponseRemainsStatusOnly(t *testing.T) {
+	t.Parallel()
+
+	for _, probe := range []staticProbe{{}, {err: context.Canceled}} {
+		response := httptest.NewRecorder()
+		newHandler(probe).ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health/ready", nil))
+		wantStatus, wantCode := "ready", http.StatusOK
+		if probe.err != nil {
+			wantStatus, wantCode = "not_ready", http.StatusServiceUnavailable
+		}
+		if response.Code != wantCode {
+			t.Fatalf("status = %d, want %d", response.Code, wantCode)
+		}
+		var body map[string]string
+		if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+			t.Fatalf("decode readiness: %v", err)
+		}
+		if !reflect.DeepEqual(body, map[string]string{"status": wantStatus}) {
+			t.Fatalf("unexpected readiness body: %v", body)
+		}
+	}
+}
