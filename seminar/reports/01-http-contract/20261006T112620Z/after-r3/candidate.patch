diff --git a/backend/internal/adapters/httpapi/liveness_test.go b/backend/internal/adapters/httpapi/liveness_test.go
new file mode 100644
index 0000000..f1c5d4c
--- /dev/null
+++ b/backend/internal/adapters/httpapi/liveness_test.go
@@ -0,0 +1,57 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+type forbiddenLivenessProbe struct{}
+
+func (forbiddenLivenessProbe) Check(context.Context) error {
+	panic("liveness must not check infrastructure")
+}
+
+func TestLivenessIncludesServiceWithoutCheckingInfrastructure(t *testing.T) {
+	t.Parallel()
+	handler := httpapi.NewHandler(httpapi.Dependencies{
+		Readiness: application.NewReadinessService(forbiddenLivenessProbe{}),
+	})
+	assertHealthBody(t, handler, "/health/live", http.StatusOK, map[string]string{
+		"status": "live", "service": "DRIP Недвижимость",
+	})
+}
+
+func TestReadinessBodyRemainsUnchanged(t *testing.T) {
+	t.Parallel()
+	assertHealthBody(t, newHandler(staticProbe{}), "/health/ready", http.StatusOK,
+		map[string]string{"status": "ready"})
+	assertHealthBody(t, newHandler(staticProbe{err: errors.New("unavailable")}),
+		"/health/ready", http.StatusServiceUnavailable, map[string]string{"status": "not_ready"})
+}
+
+func assertHealthBody(t *testing.T, handler http.Handler, path string, code int, want map[string]string) {
+	t.Helper()
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, httptest.NewRequestWithContext(t.Context(), http.MethodGet, path, nil))
+	if response.Code != code {
+		t.Fatalf("%s: HTTP status = %d, want %d", path, response.Code, code)
+	}
+	if got := response.Header().Get("Content-Type"); got != "application/json" {
+		t.Fatalf("%s: Content-Type = %q, want application/json", path, got)
+	}
+	var got map[string]string
+	if err := json.Unmarshal(response.Body.Bytes(), &got); err != nil {
+		t.Fatalf("%s: decode response: %v", path, err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%s: body = %v, want %v", path, got, want)
+	}
+}
