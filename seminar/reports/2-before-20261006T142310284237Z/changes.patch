+package httpapi_test
+
+import (
+	"context"
+	"encoding/csv"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+const exportSessionID = "01996c43-6c00-7abc-8def-1234567890ab"
+
+func TestExportSessionCSV(t *testing.T) {
+	t.Parallel()
+	zero, count := int64(0), int64(1234567890123)
+	for _, test := range []struct {
+		name          string
+		dashboard     *application.CurrentDashboard
+		source, count string
+	}{
+		{"published", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС", CumulativeDDUCount: &count}, "Текущий срез ЕИСЖС", "1234567890123"},
+		{"zero", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС", CumulativeDDUCount: &zero}, "Текущий срез ЕИСЖС", "0"},
+		{"unknown count", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС"}, "Текущий срез ЕИСЖС", ""},
+		{"no dashboard", nil, "", ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repository := &exportRepository{
+				account: application.Account{State: application.AccountActive}, authenticated: true, found: true,
+				session: application.AnalyticalSession{ID: exportSessionID, Name: "Москва, \"ЖК\"\nвторая строка\rтретья", Status: "ready", CurrentDashboard: test.dashboard},
+			}
+			before := repository.session
+			response := requestExport(t, repository, "valid-token")
+			if response.Code != http.StatusOK {
+				t.Fatalf("status = %d: %s", response.Code, response.Body)
+			}
+			if got := response.Header().Get("Content-Type"); got != "text/csv; charset=utf-8" {
+				t.Fatalf("Content-Type = %q", got)
+			}
+			if got := response.Header().Get("Content-Disposition"); got != "attachment; filename=\"session-"+exportSessionID+".csv\"" {
+				t.Fatalf("Content-Disposition = %q", got)
+			}
+			if !utf8.Valid(response.Body.Bytes()) {
+				t.Fatal("CSV is not UTF-8")
+			}
+			records, err := csv.NewReader(response.Body).ReadAll()
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := [][]string{
+				{"session_id", "name", "status", "source_label", "cumulative_ddu_count"},
+				{exportSessionID, before.Name, before.Status, test.source, test.count},
+			}
+			if !reflect.DeepEqual(records, want) {
+				t.Fatalf("records = %#v, want %#v", records, want)
+			}
+			if repository.reads != 1 || !reflect.DeepEqual(repository.session, before) {
+				t.Fatal("export must only read the saved session")
+			}
+		})
+	}
+}
+
+func TestExportSessionErrors(t *testing.T) {
+	t.Parallel()
+	storageError := errors.New("private storage failure")
+	for _, test := range []struct {
+		name, token          string
+		state                application.AccountState
+		authenticated, found bool
+		authError, readError error
+		status               int
+		code                 string
+		reads                int
+	}{
+		{name: "no cookie", state: application.AccountActive, status: 401, code: "unauthenticated"},
+		{name: "expired or revoked", token: "invalid", state: application.AccountActive, status: 401, code: "unauthenticated"},
+		{name: "pending activation", token: "valid", authenticated: true, state: application.AccountPendingActivation, status: 401, code: "unauthenticated"},
+		{name: "deactivated", token: "valid", authenticated: true, state: application.AccountDeactivated, status: 401, code: "unauthenticated"},
+		{name: "missing", token: "valid", authenticated: true, state: application.AccountActive, status: 404, code: "not_found", reads: 1},
+		{name: "hidden", token: "valid", authenticated: true, state: application.AccountActive, status: 404, code: "not_found", reads: 1},
+		{name: "storage failure", token: "valid", authenticated: true, state: application.AccountActive, readError: storageError, status: 500, code: "internal_error", reads: 1},
+		{name: "auth storage failure", token: "valid", authError: storageError, status: 500, code: "internal_error"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repository := &exportRepository{account: application.Account{State: test.state}, authenticated: test.authenticated, found: test.found, authError: test.authError, readError: test.readError}
+			response := requestExport(t, repository, test.token)
+			if response.Code != test.status {
+				t.Fatalf("status = %d: %s", response.Code, response.Body)
+			}
+			if response.Header().Get("Content-Type") != "application/json" || response.Header().Get("Content-Disposition") != "" {
+				t.Fatalf("unexpected headers: %v", response.Header())
+			}
+			var body struct {
+				Error struct{ Code, Message string }
+			}
+			if err := json.NewDecoder(response.Body).Decode(&body); err != nil {
+				t.Fatal(err)
+			}
+			if body.Error.Code != test.code || body.Error.Message == "" || body.Error.Message == storageError.Error() {
+				t.Fatalf("error = %+v", body.Error)
+			}
+			if repository.reads != test.reads {
+				t.Fatalf("session reads = %d, want %d", repository.reads, test.reads)
+			}
+		})
+	}
+}
+
+func requestExport(t *testing.T, repository *exportRepository, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	handler := httpapi.NewHandler(httpapi.Dependencies{Access: application.NewAccessService(repository, exportCredentials{})})
+	request := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/api/v1/sessions/"+exportSessionID+"/export.csv", nil)
+	if token != "" {
+		request.AddCookie(&http.Cookie{Name: "ad_session", Value: token})
+	}
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+// Unused embedded methods panic if export attempts any other repository operation.
+type exportRepository struct {
+	application.AccessRepository
+	account              application.Account
+	authenticated, found bool
+	session              application.AnalyticalSession
+	authError, readError error
+	reads                int
+}
+
+func (repository *exportRepository) FindAccountBySession(context.Context, string, time.Time, time.Time) (application.Account, bool, error) {
+	return repository.account, repository.authenticated, repository.authError
+}
+
+func (repository *exportRepository) GetAnalyticalSession(_ context.Context, id string) (application.AnalyticalSession, bool, error) {
+	repository.reads++
+	if id != exportSessionID {
+		return application.AnalyticalSession{}, false, errors.New("unexpected session ID")
+	}
+	return repository.session, repository.found, repository.readError
+}
+
+type exportCredentials struct{ application.CredentialManager }
+
+func (exportCredentials) HashSessionToken(token string) string { return token }
