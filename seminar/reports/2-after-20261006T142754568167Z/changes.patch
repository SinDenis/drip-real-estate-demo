diff --git a/backend/internal/adapters/httpapi/session_export.go b/backend/internal/adapters/httpapi/session_export.go
new file mode 100644
index 0000000..7608dba
--- /dev/null
+++ b/backend/internal/adapters/httpapi/session_export.go
@@ -0,0 +1,65 @@
+package httpapi
+
+import (
+	"bytes"
+	"context"
+	"encoding/csv"
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi/generated"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+func (service server) ExportAnalyticalSessionCSV(
+	ctx context.Context,
+	request generated.ExportAnalyticalSessionCSVRequestObject,
+) (generated.ExportAnalyticalSessionCSVResponseObject, error) {
+	session, err := service.dependencies.Access.GetAnalyticalSession(
+		ctx, cookieValue(request.Params.AdSession), request.SessionId.String(),
+	)
+	if isUnauthorized(err) {
+		return generated.ExportAnalyticalSessionCSV401JSONResponse{
+			UnauthorizedJSONResponse: generated.UnauthorizedJSONResponse(unauthorizedError()),
+		}, nil
+	}
+	if errors.Is(err, application.ErrNotFound) {
+		return generated.ExportAnalyticalSessionCSV404JSONResponse{
+			NotFoundJSONResponse: generated.NotFoundJSONResponse(notFoundError("Сессия не найдена")),
+		}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	source, count := "", ""
+	if dashboard := session.CurrentDashboard; dashboard != nil {
+		source = dashboard.SourceLabel
+		if dashboard.CumulativeDDUCount != nil {
+			count = strconv.FormatInt(*dashboard.CumulativeDDUCount, 10)
+		}
+	}
+	var payload bytes.Buffer
+	writer := csv.NewWriter(&payload)
+	if err := writer.WriteAll([][]string{
+		{"session_id", "name", "status", "source_label", "cumulative_ddu_count"},
+		{session.ID, session.Name, session.Status, source, count},
+	}); err != nil {
+		return nil, err
+	}
+	return sessionCSVResponse{payload: payload.Bytes(), sessionID: request.SessionId.String()}, nil
+}
+
+// The generated CSV response uses a bare media type; this visitor adds the UTF-8 charset.
+type sessionCSVResponse struct {
+	payload   []byte
+	sessionID string
+}
+
+func (response sessionCSVResponse) VisitExportAnalyticalSessionCSVResponse(writer http.ResponseWriter) error {
+	writer.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	writer.Header().Set("Content-Disposition", `attachment; filename="session-`+response.sessionID+`.csv"`)
+	writer.WriteHeader(http.StatusOK)
+	_, err := writer.Write(response.payload)
+	return err
+}
diff --git a/backend/internal/adapters/httpapi/session_export_test.go b/backend/internal/adapters/httpapi/session_export_test.go
new file mode 100644
index 0000000..ed59983
--- /dev/null
+++ b/backend/internal/adapters/httpapi/session_export_test.go
@@ -0,0 +1,159 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/csv"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+const exportSessionID = "01900000-0000-7000-8000-000000000001"
+
+func TestSessionCSVValues(t *testing.T) {
+	t.Parallel()
+	zero, count := int64(0), int64(1234567890123)
+	for _, test := range []struct {
+		name          string
+		dashboard     *application.CurrentDashboard
+		source, count string
+	}{
+		{"saved count", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС", CumulativeDDUCount: &count}, "Текущий срез ЕИСЖС", "1234567890123"},
+		{"known zero", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС", CumulativeDDUCount: &zero}, "Текущий срез ЕИСЖС", "0"},
+		{"unknown count", &application.CurrentDashboard{SourceLabel: "Текущий срез ЕИСЖС"}, "Текущий срез ЕИСЖС", ""},
+		{"no saved result", nil, "", ""},
+		{"escaped source", &application.CurrentDashboard{SourceLabel: "Источник, \"ЕИСЖС\"\nсрез"}, "Источник, \"ЕИСЖС\"\nсрез", ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			session := application.AnalyticalSession{
+				ID: exportSessionID, Name: "Анализ, \"Москва\"\nстрока", Status: "partial", CurrentDashboard: test.dashboard,
+			}
+			repository := &exportRepository{account: application.Account{State: application.AccountActive}, session: session, found: true}
+			response := exportRequest(t, repository, "valid")
+			if response.Code != http.StatusOK {
+				t.Fatalf("status = %d: %s", response.Code, response.Body.String())
+			}
+			if got := response.Header().Get("Content-Type"); got != "text/csv; charset=utf-8" {
+				t.Fatalf("Content-Type = %q", got)
+			}
+			if got := response.Header().Get("Content-Disposition"); got != `attachment; filename="session-`+exportSessionID+`.csv"` {
+				t.Fatalf("Content-Disposition = %q", got)
+			}
+			if !utf8.Valid(response.Body.Bytes()) {
+				t.Fatal("CSV is not UTF-8")
+			}
+			records, err := csv.NewReader(response.Body).ReadAll()
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := [][]string{
+				{"session_id", "name", "status", "source_label", "cumulative_ddu_count"},
+				{exportSessionID, session.Name, "partial", test.source, test.count},
+			}
+			if !reflect.DeepEqual(records, want) {
+				t.Fatalf("records = %#v, want %#v", records, want)
+			}
+			if repository.reads != 1 || !reflect.DeepEqual(repository.session, session) {
+				t.Fatal("export must read the saved session once without changes")
+			}
+		})
+	}
+}
+
+func TestSessionCSVErrors(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		name, token         string
+		state               application.AccountState
+		found               bool
+		storageErr, authErr error
+		status              int
+		code                string
+		reads               int
+	}{
+		{name: "missing cookie", state: application.AccountActive, found: true, status: 401, code: "unauthenticated"},
+		{name: "invalid session", token: "invalid", state: application.AccountActive, found: true, status: 401, code: "unauthenticated"},
+		{name: "pending employee", token: "valid", state: application.AccountPendingActivation, found: true, status: 401, code: "unauthenticated"},
+		{name: "inactive employee", token: "valid", state: application.AccountDeactivated, found: true, status: 401, code: "unauthenticated"},
+		{name: "missing analytical session", token: "valid", state: application.AccountActive, status: 404, code: "not_found", reads: 1},
+		// Hidden sessions are excluded by the repository port, just like missing sessions.
+		{name: "hidden analytical session", token: "valid", state: application.AccountActive, status: 404, code: "not_found", reads: 1},
+		{name: "storage failure", token: "valid", state: application.AccountActive, storageErr: errors.New("private storage details"), status: 500, code: "internal_error", reads: 1},
+		{name: "authorization storage failure", token: "valid", state: application.AccountActive, authErr: errors.New("private auth details"), status: 500, code: "internal_error"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repository := &exportRepository{account: application.Account{State: test.state}, found: test.found, err: test.storageErr, authErr: test.authErr}
+			response := exportRequest(t, repository, test.token)
+			if response.Code != test.status {
+				t.Fatalf("status = %d: %s", response.Code, response.Body.String())
+			}
+			if response.Header().Get("Content-Type") != "application/json" || response.Header().Get("Content-Disposition") != "" {
+				t.Fatalf("error headers = %v", response.Header())
+			}
+			var body struct {
+				Error struct {
+					Code string `json:"code"`
+				} `json:"error"`
+			}
+			if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+				t.Fatal(err)
+			}
+			if body.Error.Code != test.code {
+				t.Fatalf("code = %q, want %q", body.Error.Code, test.code)
+			}
+			if strings.Contains(response.Body.String(), "private") {
+				t.Fatal("storage details leaked")
+			}
+			if repository.reads != test.reads {
+				t.Fatalf("reads = %d, want %d", repository.reads, test.reads)
+			}
+		})
+	}
+}
+
+func exportRequest(t *testing.T, repository *exportRepository, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	handler := httpapi.NewHandler(httpapi.Dependencies{Access: application.NewAccessService(repository, exportCredentials{})})
+	request := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/api/v1/sessions/"+exportSessionID+"/export.csv", nil)
+	if token != "" {
+		request.AddCookie(&http.Cookie{Name: "ad_session", Value: token})
+	}
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+// Unimplemented port methods panic if export accidentally introduces a write or another operation.
+type exportRepository struct {
+	application.AccessRepository
+	account      application.Account
+	session      application.AnalyticalSession
+	found        bool
+	err, authErr error
+	reads        int
+}
+
+func (repository *exportRepository) FindAccountBySession(_ context.Context, token string, _, _ time.Time) (application.Account, bool, error) {
+	return repository.account, token == "valid", repository.authErr
+}
+
+func (repository *exportRepository) GetAnalyticalSession(_ context.Context, id string) (application.AnalyticalSession, bool, error) {
+	repository.reads++
+	if id != exportSessionID {
+		return application.AnalyticalSession{}, false, errors.New("unexpected session ID")
+	}
+	return repository.session, repository.found, repository.err
+}
+
+type exportCredentials struct{ application.CredentialManager }
+
+func (exportCredentials) HashSessionToken(token string) string { return token }
