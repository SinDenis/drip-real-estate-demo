@@ -0,0 +1,60 @@
+package httpapi
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi/generated"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+func (service server) DuplicateAnalyticalSession(
+	ctx context.Context,
+	request generated.DuplicateAnalyticalSessionRequestObject,
+) (generated.DuplicateAnalyticalSessionResponseObject, error) {
+	token := cookieValue(request.Params.AdSession)
+	source, err := service.dependencies.Access.GetAnalyticalSession(ctx, token, request.SessionId.String())
+	if isUnauthorized(err) {
+		return generated.DuplicateAnalyticalSession401JSONResponse{
+			UnauthorizedJSONResponse: generated.UnauthorizedJSONResponse(unauthorizedError()),
+		}, nil
+	}
+	if errors.Is(err, application.ErrNotFound) {
+		return generated.DuplicateAnalyticalSession404JSONResponse{
+			NotFoundJSONResponse: generated.NotFoundJSONResponse(notFoundError("Сессия не найдена")),
+		}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	session, _, err := service.dependencies.Sessions.Create(ctx, token, request.Params.IdempotencyKey,
+		application.CreateSessionInput{
+			RegionCodes:           source.RegionCodes,
+			ResidentialComplexIDs: source.ResidentialComplexIDs,
+			SegmentCodes:          source.SegmentCodes,
+		})
+	if response := createSessionErrorResponse(err); response != nil {
+		return duplicateCreateResponse{response}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	detail, err := analyticalSessionDetail(session)
+	if err != nil {
+		return nil, err
+	}
+	return generated.DuplicateAnalyticalSession201JSONResponse{
+		Body:    detail,
+		Headers: generated.DuplicateAnalyticalSession201ResponseHeaders{Location: "/api/v1/sessions/" + session.ID},
+	}, nil
+}
+
+// Creation errors have the same status and JSON contract for both operations.
+type duplicateCreateResponse struct {
+	generated.CreateAnalyticalSessionResponseObject
+}
+
+func (response duplicateCreateResponse) VisitDuplicateAnalyticalSessionResponse(w http.ResponseWriter) error {
+	return response.VisitCreateAnalyticalSessionResponse(w)
+}
