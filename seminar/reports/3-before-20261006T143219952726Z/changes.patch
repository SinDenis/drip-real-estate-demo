+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi/generated"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+const sourceID = "01996c43-6c00-7abc-8def-1234567890ab"
+
+func TestDuplicateSessionCreatesAndReplays(t *testing.T) {
+	s, h := duplicateFixture()
+	before, _ := json.Marshal(s.source)
+	first := duplicateRequest(t, h, "submit", "cookie")
+	if first.Code != 201 {
+		t.Fatalf("create: %d %s", first.Code, first.Body.String())
+	}
+	var detail generated.AnalyticalSessionDetail
+	if err := json.Unmarshal(first.Body.Bytes(), &detail); err != nil {
+		t.Fatal(err)
+	}
+	if detail.Id.String() == s.source.ID || detail.CreatedBy.Id.String() != s.account.ID || !detail.CreatedAt.Equal(s.now) || detail.Status != "collecting" || detail.CurrentEiszhsDashboard != nil || detail.ObservedWindow != nil || detail.Filters.Period != nil {
+		t.Fatalf("new session: %#v", detail)
+	}
+	if first.Header().Get("Location") != "/api/v1/sessions/"+detail.Id.String() {
+		t.Fatal("wrong Location")
+	}
+	if !reflect.DeepEqual(s.input.RegionCodes, []string{"50", "77"}) || !reflect.DeepEqual(s.input.ResidentialComplexIDs, []string{"1001", "1002"}) || !reflect.DeepEqual(s.input.SegmentCodes, []string{"residential"}) {
+		t.Fatalf("filters: %#v", s.input)
+	}
+	after, _ := json.Marshal(s.source)
+	if string(before) != string(after) {
+		t.Fatal("source changed")
+	}
+	s.source.RegionCodes = []string{"50", "77"}
+	s.source.ResidentialComplexIDs = []string{"1001", "1002", "1001"}
+	replay := duplicateRequest(t, h, "submit", "cookie")
+	if replay.Code != 201 || replay.Body.String() != first.Body.String() || replay.Header().Get("Location") != first.Header().Get("Location") || s.creates != 1 || s.resolves != 1 {
+		t.Fatalf("replay: %d %s", replay.Code, replay.Body.String())
+	}
+	s.source.RegionCodes = []string{"77"}
+	conflict := duplicateRequest(t, h, "submit", "cookie")
+	if conflict.Code != 409 || !strings.Contains(conflict.Body.String(), `"idempotency_conflict"`) {
+		t.Fatalf("conflict: %d %s", conflict.Code, conflict.Body.String())
+	}
+}
+
+func TestDuplicateSessionErrors(t *testing.T) {
+	cases := []struct {
+		name, key, token, code string
+		status                 int
+		setup                  func(*duplicateStore)
+	}{
+		{"missing key", "", "cookie", "validation_failed", 400, nil},
+		{"invalid key", strings.Repeat("a", 129), "cookie", "invalid_session_filters", 422, nil},
+		{"non ASCII key", "ключ", "cookie", "invalid_session_filters", 422, nil},
+		{"no cookie", "key", "", "unauthenticated", 401, nil},
+		{"expired cookie", "key", "cookie", "unauthenticated", 401, func(s *duplicateStore) { s.authorized = false }},
+		{"inactive account", "key", "cookie", "unauthenticated", 401, func(s *duplicateStore) { s.account.State = application.AccountDeactivated }},
+		{"missing source", "key", "cookie", "not_found", 404, func(s *duplicateStore) { s.visible = false }},
+		{"hidden source", "key", "cookie", "not_found", 404, func(s *duplicateStore) { s.visible = false }},
+		{"missing filters", "key", "cookie", "invalid_session_filters", 422, func(s *duplicateStore) { s.source.RegionCodes = nil }},
+		{"invalid filters", "key", "cookie", "invalid_session_filters", 422, func(s *duplicateStore) { s.source.SegmentCodes = []string{"unknown"} }},
+		{"unresolvable filters", "key", "cookie", "invalid_session_filters", 422, func(s *duplicateStore) { s.resolveErr = application.ErrInvalidSessionSelection }},
+		{"read failure", "key", "cookie", "", 500, func(s *duplicateStore) { s.readErr = errors.New("read failed") }},
+		{"create failure", "key", "cookie", "", 500, func(s *duplicateStore) { s.createErr = errors.New("create failed") }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s, h := duplicateFixture()
+			if tc.setup != nil {
+				tc.setup(s)
+			}
+			res := duplicateRequest(t, h, tc.key, tc.token)
+			if res.Code != tc.status {
+				t.Fatalf("status %d: %s", res.Code, res.Body.String())
+			}
+			var body struct {
+				Error struct {
+					Code string `json:"code"`
+				} `json:"error"`
+			}
+			if err := json.Unmarshal(res.Body.Bytes(), &body); err != nil {
+				t.Fatal(err)
+			}
+			if tc.code != "" && body.Error.Code != tc.code {
+				t.Fatalf("code: %q", body.Error.Code)
+			}
+			if s.creates != 0 {
+				t.Fatal("created on failed request")
+			}
+		})
+	}
+}
+
+func duplicateRequest(t *testing.T, h http.Handler, key, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequestWithContext(t.Context(), http.MethodPost, "/api/v1/sessions/"+sourceID+"/duplicate", nil)
+	if key != "" {
+		req.Header.Set("Idempotency-Key", key)
+	}
+	if token != "" {
+		req.AddCookie(&http.Cookie{Name: "ad_session", Value: token})
+	}
+	res := httptest.NewRecorder()
+	h.ServeHTTP(res, req)
+	return res
+}
+func duplicateFixture() (*duplicateStore, http.Handler) {
+	old := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := &duplicateStore{visible: true, authorized: true, now: old.AddDate(1, 0, 0),
+		account: application.Account{ID: "01996c43-6c00-7abc-8def-1234567890ac", DisplayName: "Новый автор", State: application.AccountActive},
+		source: application.AnalyticalSession{ID: sourceID, CreatedByID: "01996c43-6c00-7abc-8def-1234567890ad", CreatedAt: old, Status: "ready", Name: "Старое имя",
+			RegionCodes: []string{"77", "50"}, ResidentialComplexIDs: []string{"1002", "1001"}, SegmentCodes: []string{"residential"}, Regions: []string{"Старые подписи"}, PeriodFrom: &old, PeriodTo: &old, ObservedFrom: &old, ObservedTo: &old, ObservationIDs: []string{"old-result"}, CurrentDashboard: &application.CurrentDashboard{SourceLabel: "old"}}}
+	access := application.NewAccessService(s, duplicateCredentials{})
+	sessions := application.NewAnalyticalSessionService(access, s, func() time.Time { return s.now })
+	return s, httpapi.NewHandler(httpapi.Dependencies{Access: access, Sessions: sessions})
+}
+
+type duplicateCredentials struct{ application.CredentialManager }
+
+func (duplicateCredentials) HashSessionToken(token string) string { return token }
+
+type duplicateStore struct {
+	application.AccessRepository
+	source                         application.AnalyticalSession
+	account                        application.Account
+	visible, authorized            bool
+	now                            time.Time
+	input                          application.CreateSessionInput
+	saved                          *application.NewAnalyticalSession
+	creates, resolves              int
+	readErr, resolveErr, createErr error
+}
+
+func (s *duplicateStore) FindAccountBySession(_ context.Context, token string, _, _ time.Time) (application.Account, bool, error) {
+	return s.account, s.authorized && token == "cookie", nil
+}
+func (s *duplicateStore) GetAnalyticalSession(_ context.Context, id string) (application.AnalyticalSession, bool, error) {
+	return s.source, s.visible && id == s.source.ID, s.readErr
+}
+func (s *duplicateStore) FindAnalyticalSessionReplay(_ context.Context, key application.AnalyticalSessionIdempotency) (application.AnalyticalSession, bool, error) {
+	if s.saved == nil || s.saved.IdempotencyKey != key.IdempotencyKey || s.saved.AccountID != key.AccountID || s.saved.Endpoint != key.Endpoint {
+		return application.AnalyticalSession{}, false, nil
+	}
+	if s.saved.RequestHash != key.RequestHash {
+		return application.AnalyticalSession{}, false, application.ErrIdempotencyConflict
+	}
+	return s.saved.Session, true, nil
+}
+func (s *duplicateStore) ResolveSessionSelection(_ context.Context, input application.CreateSessionInput, _ time.Time) (application.ResolvedSessionSelection, error) {
+	s.input = input
+	s.resolves++
+	selection := application.ResolvedSessionSelection{}
+	for _, code := range input.RegionCodes {
+		selection.Regions = append(selection.Regions, application.SessionRegion{Code: code, Name: "Регион " + code})
+	}
+	for _, id := range input.ResidentialComplexIDs {
+		selection.Complexes = append(selection.Complexes, application.SessionComplex{ID: id, RegionCode: "77", Name: "ЖК " + id})
+	}
+	return selection, s.resolveErr
+}
+func (s *duplicateStore) CreateAnalyticalSession(_ context.Context, input application.NewAnalyticalSession) (application.AnalyticalSession, bool, error) {
+	if s.createErr != nil {
+		return application.AnalyticalSession{}, false, s.createErr
+	}
+	s.creates++
+	s.saved = &input
+	return input.Session, false, nil
+}
