@@ -0,0 +1,201 @@
+package httpapi_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi/generated"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+const duplicateSourceID = "01996c43-6c00-7abc-8def-1234567890ab"
+
+// Embedded ports fail immediately if the operation unexpectedly calls unrelated methods.
+type duplicateStore struct {
+	application.AccessRepository
+	application.AnalyticalSessionRepository
+	account    application.Account
+	source     application.AnalyticalSession
+	hidden     bool
+	readErr    error
+	resolveErr error
+	createErr  error
+	replays    map[application.AnalyticalSessionIdempotency]application.AnalyticalSession
+	created    []application.NewAnalyticalSession
+}
+
+func (store *duplicateStore) FindAccountBySession(_ context.Context, token string, _, _ time.Time) (application.Account, bool, error) {
+	return store.account, token == "active" && store.account.State != application.AccountDeactivated, nil
+}
+func (store *duplicateStore) GetAnalyticalSession(_ context.Context, id string) (application.AnalyticalSession, bool, error) {
+	return store.source, id == duplicateSourceID && !store.hidden, store.readErr
+}
+func (store *duplicateStore) FindAnalyticalSessionReplay(_ context.Context, key application.AnalyticalSessionIdempotency) (application.AnalyticalSession, bool, error) {
+	for previous, session := range store.replays {
+		if previous.AccountID == key.AccountID && previous.Endpoint == key.Endpoint && previous.IdempotencyKey == key.IdempotencyKey {
+			if previous.RequestHash != key.RequestHash {
+				return application.AnalyticalSession{}, false, application.ErrIdempotencyConflict
+			}
+			return session, true, nil
+		}
+	}
+	return application.AnalyticalSession{}, false, nil
+}
+func (store *duplicateStore) ResolveSessionSelection(_ context.Context, input application.CreateSessionInput, _ time.Time) (application.ResolvedSessionSelection, error) {
+	return application.ResolvedSessionSelection{
+		Regions:   []application.SessionRegion{{Code: input.RegionCodes[0], Name: "Москва"}},
+		Complexes: []application.SessionComplex{{ID: input.ResidentialComplexIDs[0], RegionCode: "77", Name: "Новый ЖК"}},
+	}, store.resolveErr
+}
+func (store *duplicateStore) CreateAnalyticalSession(_ context.Context, input application.NewAnalyticalSession) (application.AnalyticalSession, bool, error) {
+	if store.createErr != nil {
+		return application.AnalyticalSession{}, false, store.createErr
+	}
+	store.created = append(store.created, input)
+	key := application.AnalyticalSessionIdempotency{AccountID: input.AccountID, Endpoint: input.Endpoint, IdempotencyKey: input.IdempotencyKey, RequestHash: input.RequestHash}
+	store.replays[key] = input.Session
+	return input.Session, false, nil
+}
+
+type duplicateCredentials struct{ application.CredentialManager }
+
+func (duplicateCredentials) HashSessionToken(token string) string { return token }
+
+func duplicateFixture() (*duplicateStore, http.Handler, time.Time) {
+	now := time.Date(2026, 10, 6, 12, 0, 0, 0, time.UTC)
+	old := now.AddDate(0, -2, 0)
+	store := &duplicateStore{
+		account: application.Account{ID: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", State: application.AccountActive, DisplayName: "Новый автор"},
+		source: application.AnalyticalSession{
+			ID: duplicateSourceID, Name: "Старое название", Status: "complete", CreatedAt: old,
+			CreatedByID: "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", CreatedByDisplayName: "Старый автор",
+			RegionCodes: []string{"77"}, ResidentialComplexIDs: []string{"1001"}, SegmentCodes: []string{"residential"},
+			Regions: []string{"Старый регион"}, ResidentialComplexes: []string{"Старый ЖК"}, Segments: []string{"Старый сегмент"},
+			ObservationIDs: []string{"old-observation"}, ObservedFrom: &old, ObservedTo: &old, PeriodFrom: &old, PeriodTo: &old,
+			CurrentDashboard: &application.CurrentDashboard{SourceLabel: "old-source"},
+		},
+		replays: make(map[application.AnalyticalSessionIdempotency]application.AnalyticalSession),
+	}
+	access := application.NewAccessService(store, duplicateCredentials{})
+	return store, httpapi.NewHandler(httpapi.Dependencies{
+		Access: access, Sessions: application.NewAnalyticalSessionService(access, store, func() time.Time { return now }),
+	}), now
+}
+
+func duplicateRequest(t *testing.T, handler http.Handler, id, token, key string) *httptest.ResponseRecorder {
+	t.Helper()
+	request := httptest.NewRequestWithContext(t.Context(), http.MethodPost, "/api/v1/sessions/"+id+"/duplicate", nil)
+	if token != "" {
+		request.AddCookie(&http.Cookie{Name: "ad_session", Value: token})
+	}
+	if key != "" {
+		request.Header.Set("Idempotency-Key", key)
+	}
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+func TestDuplicateSessionCreatesAndReplaysCanonicalSelection(t *testing.T) {
+	store, handler, now := duplicateFixture()
+	before, _ := json.Marshal(store.source)
+	response := duplicateRequest(t, handler, duplicateSourceID, "active", "same-key")
+	if response.Code != 201 {
+		t.Fatalf("status %d: %s", response.Code, response.Body)
+	}
+	var detail generated.AnalyticalSessionDetail
+	if err := json.Unmarshal(response.Body.Bytes(), &detail); err != nil {
+		t.Fatal(err)
+	}
+	if detail.Id.String() == duplicateSourceID || detail.CreatedBy.Id.String() != store.account.ID || !detail.CreatedAt.Equal(now) ||
+		detail.Status != "collecting" || detail.Name != "Москва - Новый ЖК" || detail.CurrentEiszhsDashboard != nil || detail.ObservedWindow != nil || detail.Filters.Period != nil {
+		t.Fatalf("copied stale session fields: %#v", detail)
+	}
+	if response.Header().Get("Location") != "/api/v1/sessions/"+detail.Id.String() {
+		t.Fatal("incorrect Location")
+	}
+	created := store.created[0].Session
+	if !reflect.DeepEqual(created.RegionCodes, store.source.RegionCodes) || !reflect.DeepEqual(created.ResidentialComplexIDs, store.source.ResidentialComplexIDs) ||
+		!reflect.DeepEqual(created.SegmentCodes, store.source.SegmentCodes) || len(created.ObservationIDs) != 0 {
+		t.Fatalf("filters/results: %#v", created)
+	}
+	after, _ := json.Marshal(store.source)
+	if string(before) != string(after) {
+		t.Fatal("source changed")
+	}
+	// Duplicate identifiers and whitespace canonicalize to the same creation request.
+	store.source.ResidentialComplexIDs = []string{" 1001 ", "1001"}
+	replay := duplicateRequest(t, handler, duplicateSourceID, "active", "same-key")
+	if replay.Code != 201 || replay.Body.String() != response.Body.String() || replay.Header().Get("Location") != response.Header().Get("Location") || len(store.created) != 1 {
+		t.Fatalf("replay: %d %s", replay.Code, replay.Body)
+	}
+	// The ordinary creation endpoint shares the same logical idempotency scope.
+	request := httptest.NewRequestWithContext(t.Context(), http.MethodPost, "/api/v1/sessions", strings.NewReader(`{"regionCodes":["77"],"residentialComplexIds":["1001"],"segmentCodes":["residential"]}`))
+	request.AddCookie(&http.Cookie{Name: "ad_session", Value: "active"})
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Idempotency-Key", "same-key")
+	ordinaryReplay := httptest.NewRecorder()
+	handler.ServeHTTP(ordinaryReplay, request)
+	if ordinaryReplay.Code != 201 || ordinaryReplay.Body.String() != response.Body.String() || len(store.created) != 1 {
+		t.Fatalf("ordinary creation replay: %d %s", ordinaryReplay.Code, ordinaryReplay.Body)
+	}
+	store.source.ResidentialComplexIDs = []string{"1002"}
+	conflict := duplicateRequest(t, handler, duplicateSourceID, "active", "same-key")
+	if conflict.Code != 409 || !strings.Contains(conflict.Body.String(), `"code":"idempotency_conflict"`) {
+		t.Fatalf("conflict: %d %s", conflict.Code, conflict.Body)
+	}
+}
+
+func TestDuplicateSessionErrorsThroughNewHandler(t *testing.T) {
+	for _, test := range []struct {
+		name, token, key, id, code string
+		status                     int
+		setup                      func(*duplicateStore)
+	}{
+		{name: "missing key", token: "active", id: duplicateSourceID, status: 400, code: "validation_failed"},
+		{name: "invalid key", token: "active", key: strings.Repeat("x", 129), id: duplicateSourceID, status: 422, code: "invalid_session_filters"},
+		{name: "unauthenticated", key: "key", id: duplicateSourceID, status: 401, code: "unauthenticated"},
+		{name: "pending", token: "active", key: "key", id: duplicateSourceID, status: 401, code: "unauthenticated", setup: func(s *duplicateStore) { s.account.State = application.AccountPendingActivation }},
+		{name: "deactivated", token: "active", key: "key", id: duplicateSourceID, status: 401, code: "unauthenticated", setup: func(s *duplicateStore) { s.account.State = application.AccountDeactivated }},
+		{name: "missing", token: "active", key: "key", id: "cccccccc-cccc-4ccc-8ccc-cccccccccccc", status: 404, code: "not_found"},
+		{name: "hidden", token: "active", key: "key", id: duplicateSourceID, status: 404, code: "not_found", setup: func(s *duplicateStore) { s.hidden = true }},
+		{name: "invalid filters", token: "active", key: "key", id: duplicateSourceID, status: 422, code: "invalid_session_filters", setup: func(s *duplicateStore) { s.source.SegmentCodes = []string{"unknown"} }},
+		{name: "legacy labels only", token: "active", key: "key", id: duplicateSourceID, status: 422, code: "invalid_session_filters", setup: func(s *duplicateStore) { s.source.RegionCodes = nil }},
+		{name: "read failure", token: "active", key: "key", id: duplicateSourceID, status: 500, setup: func(s *duplicateStore) { s.readErr = errors.New("read failed") }},
+		{name: "resolve failure", token: "active", key: "key", id: duplicateSourceID, status: 500, setup: func(s *duplicateStore) { s.resolveErr = errors.New("resolve failed") }},
+		{name: "create failure", token: "active", key: "key", id: duplicateSourceID, status: 500, setup: func(s *duplicateStore) { s.createErr = errors.New("create failed") }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			store, handler, _ := duplicateFixture()
+			if test.setup != nil {
+				test.setup(store)
+			}
+			response := duplicateRequest(t, handler, test.id, test.token, test.key)
+			if response.Code != test.status {
+				t.Fatalf("status %d want %d: %s", response.Code, test.status, response.Body)
+			}
+			var envelope struct {
+				Error struct {
+					Code string `json:"code"`
+				} `json:"error"`
+			}
+			if err := json.Unmarshal(response.Body.Bytes(), &envelope); err != nil {
+				t.Fatal(err)
+			}
+			if test.code != "" && envelope.Error.Code != test.code {
+				t.Fatalf("code = %q", envelope.Error.Code)
+			}
+			if len(store.created) != 0 {
+				t.Fatal("created a session on failure")
+			}
+		})
+	}
+}
