+package httpapi
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/adapters/httpapi/generated"
+	"github.com/SinDenis/drip-real-estate-demo/backend/internal/application"
+)
+
+// DuplicateAnalyticalSession translates only canonical filters into the shared creation use case.
+func (service server) DuplicateAnalyticalSession(ctx context.Context, request generated.DuplicateAnalyticalSessionRequestObject) (generated.DuplicateAnalyticalSessionResponseObject, error) {
+	token := cookieValue(request.Params.AdSession)
+	source, err := service.dependencies.Access.GetAnalyticalSession(ctx, token, request.SessionId.String())
+	if errors.Is(err, application.ErrNotFound) {
+		return generated.DuplicateAnalyticalSession404JSONResponse{NotFoundJSONResponse: generated.NotFoundJSONResponse(notFoundError("Сессия не найдена"))}, nil
+	}
+	if response := createSessionErrorResponse(err); response != nil {
+		return duplicateCreationResponse{response}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	session, _, err := service.dependencies.Sessions.Create(ctx, token, request.Params.IdempotencyKey, application.CreateSessionInput{
+		RegionCodes: source.RegionCodes, ResidentialComplexIDs: source.ResidentialComplexIDs, SegmentCodes: source.SegmentCodes,
+	})
+	if response := createSessionErrorResponse(err); response != nil {
+		return duplicateCreationResponse{response}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	detail, err := analyticalSessionDetail(session)
+	if err != nil {
+		return nil, err
+	}
+	return generated.DuplicateAnalyticalSession201JSONResponse{
+		Body: detail, Headers: generated.DuplicateAnalyticalSession201ResponseHeaders{Location: "/api/v1/sessions/" + session.ID},
+	}, nil
+}
+
+// Creation errors retain the same status and JSON envelope at both entry points.
+type duplicateCreationResponse struct {
+	generated.CreateAnalyticalSessionResponseObject
+}
+
+func (response duplicateCreationResponse) VisitDuplicateAnalyticalSessionResponse(writer http.ResponseWriter) error {
+	return response.VisitCreateAnalyticalSessionResponse(writer)
+}
