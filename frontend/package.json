{
  "name": "drip-real-estate-demo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "e2e": "playwright test",
    "generate:api": "pnpm --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 dlx openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "architecture": "depcruise --config dependency-cruiser.config.cjs src",
    "format:check": "prettier --check .",
    "lint": "eslint e2e src playwright.config.ts vite.config.ts vitest.config.ts --max-warnings 0 && pnpm format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "antd": "6.6.2",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-sonarjs": "4.2.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
